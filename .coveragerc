[run]
branch = True
source = .
omit =
    venv/*
    tests/*
    testdata/*
    scratch/*
    notebook/*
    **/__init__.py

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
